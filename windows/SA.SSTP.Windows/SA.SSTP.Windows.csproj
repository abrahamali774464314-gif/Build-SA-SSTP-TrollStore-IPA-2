<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SA_SSTP_Windows</AssemblyName>
    <RootNamespace>SaSstp</RootNamespace>
    <Version>1.0.1</Version>
    <Company>SA SSTP</Company>
    <Product>SA SSTP for Windows</Product>
    <Description>Secure SSTP VPN profile manager</Description>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="servers.json" LogicalName="SaSstp.Catalog" /></ItemGroup>
</Project>
